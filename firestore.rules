rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Solo tu puoi leggere e scrivere. Metti la TUA email al posto di quella qui sotto
      // (se un domani vuoi dare accesso a un collaboratore, aggiungi la sua email nella lista).
      allow read, write: if request.auth != null
        && request.auth.token.email in ['donatodavide67@gmail.com'];
    }
  }
}
